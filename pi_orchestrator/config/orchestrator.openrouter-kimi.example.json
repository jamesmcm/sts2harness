{
  "rpc_server_command": [
    "python",
    "pi_agent/rpc_server.py",
    "--config",
    "/var/lib/sts2harness/official/pi_agent.json"
  ],
  "model": {
    "provider": "openrouter",
    "model": "moonshotai/kimi-k2.6",
    "api_key_env": "OPENROUTER_API_KEY",
    "timeout": 300
  },
  "max_steps": 200,
  "stop_on_game_over": true,
  "decision_log": "/var/lib/sts2harness/agents/pi-agent/decisions-kimi-k2.6.jsonl",
  "prompt_template": "pi_orchestrator/prompts/decision_prompt.md"
}
