{
  "rpc_server_command": [
    "python",
    "pi_agent/rpc_server.py",
    "--config",
    "/var/lib/sts2harness/official/pi_agent.json"
  ],
  "model": {
    "provider": "opencode_go",
    "model": "deepseek-v4-flash",
    "api_key_env": "OPENCODE_API_KEY",
    "base_url": "https://opencode.ai/zen/go/v1",
    "timeout": 300
  },
  "agent_context": {
    "enabled": false,
    "compaction_token_threshold": 900000,
    "prompt_cache": true
  },
  "stop_on_game_over": true,
  "decision_log": "/var/lib/sts2harness/agents/pi-agent/decisions.jsonl",
  "prompt_template": "pi_orchestrator/prompts/decision_prompt.md"
}
