{
  "rpc_server_command": [
    "python",
    "pi_agent/rpc_server.py",
    "--config",
    "pi_agent/config/pi_agent.opencode-go.local.json"
  ],
  "model": {
    "provider": "opencode_go",
    "model": "deepseek-v4-flash",
    "api_key_env": "OPENCODE_API_KEY",
    "timeout": 300
  },
  "stop_on_game_over": false,
  "decision_log": "pi_orchestrator/runs.opencode-go.local.jsonl",
  "prompt_template": "pi_orchestrator/prompts/decision_prompt.md"
}
